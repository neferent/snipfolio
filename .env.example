# Lemon Squeezy
NUXT_LS_API_KEY=your-ls-api-key
NUXT_LS_WEBHOOK_SECRET=your-webhook-signing-secret
NUXT_PUBLIC_LS_STORE_ID=your-store-id
NUXT_PUBLIC_LS_PRO_VARIANT_ID=
NUXT_PUBLIC_LS_PRO_EARLY_VARIANT_ID=
NUXT_PUBLIC_LS_DAY_PASS_VARIANT_ID=

# Supabase
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-anon-key
NUXT_SUPABASE_SERVICE_KEY=your-service-role-key   # Admin API — never expose to client

# Set to true to enable the app (dashboard, login, project routes)
NUXT_PUBLIC_APP_ENABLED=false

# Screenshot service
SCREENSHOTTER_URL=http://localhost:3000
SCREENSHOTTER_TOKEN=your-token
