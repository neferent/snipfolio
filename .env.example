# Auth mode: 'supabase' for production, 'local' for offline dev
NUXT_PUBLIC_AUTH_MODE=local

# Supabase (required when AUTH_MODE=supabase)
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-anon-key

# Local dev auth (required when AUTH_MODE=local)
LOCAL_DEV_EMAIL=dev@example.com
LOCAL_DEV_PASSWORD=devpassword123
LOCAL_JWT_SECRET=local-dev-secret-change-in-prod-min-32-chars
