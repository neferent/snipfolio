{
  "name": "snipfolio-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "concurrently -k -s first -n nuxt,electron \"nuxt dev\" \"wait-on http://localhost:3000 && ELECTRON_DEV=1 electron .\"",
    "generate:electron": "NUXT_APP_BASE_URL=./ nuxt generate",
    "electron:build": "npm run generate:electron && electron-builder",
    "electron:pack": "npm run generate:electron && electron-builder --dir"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@headlessui/vue": "^1.7.23",
    "@pinia/colada": "^1.3.1",
    "@pinia/nuxt": "^0.11.3",
    "@vueuse/core": "^14.3.0",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.4.6",
    "pinia": "^3.0.4",
    "playwright": "1.60.0",
    "tailwindcss": "^4.3.0",
    "vue": "latest",
    "vue-router": "latest",
    "vue-sonner": "^2.0.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.2",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.0",
    "unplugin-auto-import": "^21.0.0",
    "vitest": "^4.1.8",
    "vue-tsc": "^2.1.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "io.snipfol.local",
    "productName": "Snipfolio",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      ".output/public/**/*"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
